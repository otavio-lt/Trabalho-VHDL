library IEEE;
use IEEE.STD_LOGIC_1164.ALL;

entity full_adder is
    port (
        A    : in  std_logic;
        B    : in  std_logic;
        Cin  : in  std_logic;
        S    : out std_logic;
        Cout : out std_logic
    );
end full_adder;

architecture arch_full_adder of full_adder is
    signal xor_ab : std_logic;
begin
    xor_ab <= A xor B;
	 
    S <= xor_ab xor Cin;

    Cout <= (A and B) or (Cin and xor_ab);
	 
end arch_full_adder;